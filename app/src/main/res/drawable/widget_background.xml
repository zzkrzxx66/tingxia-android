<?xml version="1.0" encoding="utf-8"?>
<!--
  Square on the start edge, rounded on the end edge. The cover carries the mirror of this shape, so
  cover and panel together form one rounded rectangle with a straight seam down the middle instead of
  two shapes with facing curves. The stroke runs around all four edges, but the start edge sits 2dp
  under the cover, so only the outer rim shows.

  Pre-Android 12 fallback: a neutral scrim with the same gradient and rim as the tinted version,
  because setBackgroundTintList on a RemoteViews child needs API 31. See drawable-v31 for the copy
  that takes the cover's colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_surface_deep"
        android:startColor="@color/widget_surface"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="@dimen/widget_corner"
        android:topLeftRadius="0dp"
        android:topRightRadius="@dimen/widget_corner" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
</shape>

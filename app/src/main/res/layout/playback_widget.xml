<?xml version="1.0" encoding="utf-8"?>
<!--
  Two-row layout, matched against the reference widget side by side.

  What the reference gets right and this now copies: the artwork is a tile standing beside the panel
  (only just overlapping it) at the panel's full height, the panel is a light-grey scrim rather than a
  dark slab, and the three controls are large and spread across the whole width. What differs on
  purpose: an audiobook keeps its progress hairline and position line, because "how far into a
  1500-chapter book am I" is the thing a listener glances at.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fixed height, centred: whatever footprint the launcher hands out, the widget draws one
         strip instead of stretching into a slab. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="100dp"
        android:background="@drawable/widget_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_no_media"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_tap_to_resume"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous_chapter"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_on_control" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/play"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_circle" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next_chapter"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_on_control" />
        </LinearLayout>
    </LinearLayout>

    <!-- A tile beside the panel, not a thumbnail inside it: full panel height, 3:4 because these are
         books, overlapping the panel edge by 20dp so the two read as one object. -->
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_artwork_placeholder" />
</FrameLayout>

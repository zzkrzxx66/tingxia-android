<?xml version="1.0" encoding="utf-8"?>
<!--
  Two-row layout, designed as a two-row widget rather than as a stretched strip.

  Most Chinese launchers ignore targetCellHeight and place this at 4x2 whatever the manifest asks
  for, so this is the size that has to look right. The artwork therefore fills the panel's full inner
  height, and the content on the right runs top to bottom — title, chapter, progress, position, then
  controls spread across the width — so there are no empty grey bands left over.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="34dp"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:paddingStart="90dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_no_media"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <!-- Spacer that soaks up whatever height the launcher gives us, so the block below stays
             pinned to the foot of the panel instead of floating in the middle. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_tap_to_resume"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous_chapter"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_on_control" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/play"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_circle"
                android:tint="@color/widget_on_primary_control" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next_chapter"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_on_control" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork_placeholder" />
</FrameLayout>

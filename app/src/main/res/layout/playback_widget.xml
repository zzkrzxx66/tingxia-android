<?xml version="1.0" encoding="utf-8"?>
<!--
  The tall size: the same cover-beside-panel object as the strip, with room for the chapter line and
  larger controls. An audiobook keeps its progress hairline and its elapsed/total, because "how far
  into a 1500-chapter book am I" is the thing a listener glances at.

  The panel's colour comes from the cover at render time (see PlaybackWidgetUpdater.panelTint), so the
  background here is only the shape and the alpha gradient that tint is poured into.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fixed height, centred: whatever footprint the launcher hands out, the widget draws one
         strip instead of stretching into a slab. -->
    <LinearLayout
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="98dp"
        android:background="@drawable/widget_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_no_media"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/widget_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_tap_to_resume"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- One centred group at fixed sizes, matching the strip's control language. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous_chapter"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_on_control" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/play"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_circle" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next_chapter"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_on_control" />
        </LinearLayout>
    </LinearLayout>

    <!-- A tile beside the panel, not a thumbnail inside it: exactly the panel's 132dp height and
         flush against its start edge, with the panel running 2dp underneath so the two read as one
         object with a straight seam. The bitmap itself is rounded on the start edge only. -->
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="100dp"
        android:layout_height="132dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork_placeholder" />
</FrameLayout>

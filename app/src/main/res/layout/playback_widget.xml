<?xml version="1.0" encoding="utf-8"?>
<!--
  Two-row size. Same strip anatomy, scaled up: the artwork grows to the height of the content block
  and the block itself is centred, so the panel is filled rather than framing a grey void. The
  controls move under the text because at this width three of them plus a title do not share a row.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="34dp"
        android:background="@drawable/widget_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="76dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_chapter_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_no_media"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_tap_to_resume"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_previous"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/previous_chapter"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_previous"
                    android:tint="@color/widget_on_control" />

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/widget_primary_control_background"
                    android:contentDescription="@string/play"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play"
                    android:tint="@color/widget_on_primary_control" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/next_chapter"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_next"
                    android:tint="@color/widget_on_control" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="96dp"
        android:layout_height="128dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork_placeholder" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Short widget: artwork, two lines, a hairline of progress, play and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="40dp"
        android:layout_height="53dp"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_no_media"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:text="@string/widget_tap_to_resume"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/previous_chapter"
        android:src="@drawable/ic_widget_previous"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_primary_control_background"
        android:contentDescription="@string/play"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_on_primary_control" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/next_chapter"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next"
        android:tint="@color/widget_on_control" />
</LinearLayout>

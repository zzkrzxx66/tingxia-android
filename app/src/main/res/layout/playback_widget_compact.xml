<?xml version="1.0" encoding="utf-8"?>
<!--
  The strip. Two content rows (one line of text, one row of controls) plus a progress hairline, all
  in flow — an absolutely positioned hairline collided with the play ring. The artwork is as tall as
  the widget and overlaps the panel's start edge, so the two touch instead of the cover floating
  beside a gap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="68dp"
        android:background="@drawable/widget_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:text="@string/widget_no_media"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous_chapter"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_on_control" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/play"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_circle" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next_chapter"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_on_control" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:text="@string/widget_tap_to_resume"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_artwork_placeholder" />
</FrameLayout>

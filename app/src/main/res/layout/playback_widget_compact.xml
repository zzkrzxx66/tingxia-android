<?xml version="1.0" encoding="utf-8"?>
<!--
  The strip, stacked: title with elapsed/total on its baseline, controls, then the progress hairline
  along the bottom. Row heights are counted to fit the 72dp strip — with the time on its own row the
  content came to 90dp and the launcher clipped the bottom line in half.

  Panel and cover both fill the cell: a fixed-height strip centred in the cell left a band of wallpaper
  above and below it. The cover's bitmap is rendered for the measured cell height (see
  widgetSlotHeightDp — MAX_HEIGHT in portrait, not MIN_HEIGHT), so filling its box costs the artwork
  only the couple of percent the measurement is off by.

  The panel's colour comes from the cover at render time (see PlaybackWidgetUpdater.widgetPanelTint),
  so the background here is only the shape and the alpha gradient that tint is poured into.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="62dp"
        android:background="@drawable/widget_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="3dp"
        android:paddingEnd="14dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- On the title's baseline rather than a row of its own: the strip has no spare line. -->
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_tap_to_resume"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:text="@string/widget_no_media"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/previous_chapter"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous"
                android:tint="@color/widget_on_control" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="26dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/play"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_circle" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="26dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next_chapter"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next"
                android:tint="@color/widget_on_control" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <!-- Full cell height, flush against the panel's start edge, with the panel running 2dp underneath
         so no hairline can open at the seam. 64dp wide because a 64dp x ~87dp box is close to a book's
         3:4 at the height a one-cell strip actually gets. -->
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork_placeholder" />
</FrameLayout>
